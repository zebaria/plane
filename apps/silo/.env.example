SILO_PORT=3005
SILO_BASE_PATH=/silo
SILO_HMAC_SECRET_KEY=dev-insecure-silo-hmac
API_INTERNAL_BASE_URL=http://localhost:8800

# Phase 4g GitHub Enterprise Server SSRF guard. Comma-separated
# allowlist of permitted GHES origins. A GHES install/oauth request is
# rejected unless its origin (scheme + host + optional port) matches an
# entry here. Leave empty to allow only cloud github.com.
# Example: GITHUB_GHES_ALLOWED_HOSTS=https://ghe.acme.com,https://ghe.internal:8443
GITHUB_GHES_ALLOWED_HOSTS=