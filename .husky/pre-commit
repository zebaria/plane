#!/bin/bash
#
# Auto-bump the promote version, then run lint-staged.
#
# The check-version CI gate fails a preview->master promote PR when
# preview's package.json version equals master's, and `promote` does not
# auto-bump. So: on the `preview` branch, if the version still equals
# master's (i.e. hasn't been bumped since the last promote), bump the
# patch and stage it so it lands in this commit. Once bumped, later
# commits in the same cycle see version != master and skip. Result:
# exactly one bump per promote cycle, with no manual step.
#
# Bypass (rare): git commit --no-verify.

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$branch" = "preview" ]; then
    pkg="$(git rev-parse --show-toplevel)/package.json"
    read_ver() { sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -1; }

    cur=$(read_ver "$pkg")
    mas=$(git show origin/master:package.json 2>/dev/null | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)

    if [ -n "$cur" ] && [ "$cur" = "$mas" ]; then
        case "$cur" in
            *.*.*)
                major=${cur%%.*}; rest=${cur#*.}; minor=${rest%%.*}; patch=${rest#*.}
                if printf '%s' "$patch" | grep -q '^[0-9][0-9]*$'; then
                    next="$major.$minor.$((patch + 1))"
                    # Replace only the first "version": "X" occurrence.
                    perl -i -pe 'if (!$done && s/("version"\s*:\s*")'"$cur"'(")/${1}'"$next"'${2}/) { $done = 1 }' "$pkg"
                    git add "$pkg"
                    echo "pre-commit: bumped version $cur -> $next for promote (staged)"
                fi
                ;;
        esac
    fi
fi

# check-version also requires apps/api/pyproject.toml's version to equal
# package.json's, and neither the bump above nor ship's bumpversion-vg
# touches pyproject.toml. Whenever package.json's version is staged
# (any branch), copy it into pyproject.toml and refresh uv.lock.
root="$(git rev-parse --show-toplevel)"
pyproject="$root/apps/api/pyproject.toml"
if [ -f "$pyproject" ]; then
    staged_ver=$(git show :package.json 2>/dev/null | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    api_ver=$(sed -n 's/^version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$pyproject" | head -1)
    if [ -n "$staged_ver" ] && [ -n "$api_ver" ] && [ "$staged_ver" != "$api_ver" ]; then
        perl -i -pe 'if (!$done && s/^(version\s*=\s*")[^"]*(")/${1}'"$staged_ver"'${2}/) { $done = 1 }' "$pyproject"
        uv_pin=$(sed -n 's/^required-version[[:space:]]*=[[:space:]]*"==\([^"]*\)".*/\1/p' "$pyproject" | head -1)
        if ! (cd "$root/apps/api" && uvx "uv@${uv_pin:-latest}" lock --quiet); then
            echo "pre-commit: failed to refresh apps/api/uv.lock after setting version $staged_ver" >&2
            exit 1
        fi
        git add "$pyproject" "$root/apps/api/uv.lock"
        echo "pre-commit: synced apps/api/pyproject.toml version $api_ver -> $staged_ver (staged)"
    fi
fi

pnpm lint-staged