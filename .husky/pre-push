#!/bin/bash
#
# Pre-push hook: scan outgoing commits with gitleaks before they leave
# the workstation. Mirrors the CI zebaria-secret-scan workflow but
# blocks the push instead of just failing CI after the fact.
#
# Bypass with `git push --no-verify` (CI still scans server-side).

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks not installed — push blocked."
    echo "  Install: brew install gitleaks"
    echo "  Bypass (NOT recommended): git push --no-verify"
    exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
CONFIG="$REPO_ROOT/.gitleaks.toml"
ZERO=0000000000000000000000000000000000000000

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref pushed.
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch: scan commits not yet on any remote tracking branch.
        # Fall back to just the head commit on a fresh clone with no
        # remote-tracking refs (git log --not --remotes errors on no refs).
        if git show-ref --remotes >/dev/null 2>&1; then
            log_opts="$local_sha --not --remotes"
        else
            log_opts="$local_sha"
        fi
    else
        log_opts="$remote_sha..$local_sha"
    fi

    echo "pre-push: gitleaks scan ($log_opts)"
    if [ -f "$CONFIG" ]; then
        gitleaks detect \
            --source "$REPO_ROOT" \
            --config "$CONFIG" \
            --log-opts="$log_opts" \
            --redact \
            --no-banner || fail=1
    else
        gitleaks detect \
            --source "$REPO_ROOT" \
            --log-opts="$log_opts" \
            --redact \
            --no-banner || fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo
    echo "pre-push: gitleaks found secrets in outgoing commits. Push blocked."
    echo "  - Rotate any leaked credentials BEFORE doing anything else."
    echo "  - Rewrite history (interactive rebase / reset) to remove the secret."
    echo "  - If this is a known false positive, add an inline 'gitleaks:allow'"
    echo "    or extend .gitleaks.toml's allowlist."
    echo "  - Bypass only if you understand the consequences: git push --no-verify"
    exit 1
fi

exit 0